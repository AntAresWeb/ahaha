# HH.ru OAuth Settings
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here
HH_TOKEN=your_client_token_here
HH_REDIRECT_URI=http://localhost:8080/callback

# API Settings
HH_API_BASE_URL=https://api.hh.ru
HH_OAUTH_BASE_URL=https://hh.ru

# Application Settings
TOKEN_FILE=tokens.json
AUTO_REFRESH_THRESHOLD_SECONDS=300
LOG_LEVEL=INFO